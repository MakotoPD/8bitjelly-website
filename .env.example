# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/8bitjelly

# Admin panel password (used for /admin login)
ADMIN_PASSWORD=your-secure-password-here

# Session encryption secret — min 32 chars (nuxt-auth-utils uses NUXT_SESSION_PASSWORD)
NUXT_SESSION_PASSWORD=your-32-char-secret-here

# Cloudflare R2 image storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=8bitjelly
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Resend — email sending (invitations, 2FA codes)
# Sign up at resend.com, add domain 8bitjelly.com, copy API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@8bitjelly.com

# Public URL of this app (used in invitation email links)
APP_URL=https://8bitjelly.com
